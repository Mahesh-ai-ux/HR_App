# ─────────────────────────────────────────────────────
#  NEXILA HR — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────

# ── App Settings ──────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Security ──────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=nexila_hr_secret_2024_x9k_change_in_production

# ── Email / SMTP (for payslip delivery) ───────────────
# Gmail: enable "App Passwords" in Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hr_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── Office Geofence ───────────────────────────────────
# Nexila Technologies, West Tambaram, Chennai
OFFICE_LAT=12.9291
OFFICE_LNG=80.1003
GEOFENCE_RADIUS_M=500

# ── Database ──────────────────────────────────────────
# SQLite (default) — file-based, no setup needed
DATABASE_URL=sqlite:///./nexila_hr.db

# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/nexila_hr
